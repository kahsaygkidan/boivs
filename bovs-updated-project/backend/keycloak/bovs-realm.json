{
  "realm": "bovs",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 300,
  "roles": {
    "realm": [
      { "name": "MAKER", "description": "Registers beneficial owner records and submits them for verification" },
      { "name": "CHECKER", "description": "Reviews, approves, rejects, or ceases beneficial owner records" },
      { "name": "AUDITOR", "description": "Read-only access to all records and the full audit trail" },
      { "name": "ADMIN", "description": "Full administrative access across all workflow stages" }
    ]
  },
  "clients": [
    {
      "clientId": "bovs-frontend",
      "name": "BOVS Frontend (Vite/React SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [ "http://localhost:5173/*" ],
      "webOrigins": [ "http://localhost:5173" ]
    },
    {
      "clientId": "bovs-backend",
      "name": "BOVS Backend (confidential, mediates login/refresh/logout for the SPA)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "change-me-in-production",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
