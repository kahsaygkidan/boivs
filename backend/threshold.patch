+        assertTrue(policy.qualifiesByOwnership(mining, direct("0", null, null, null, "5", false)));
+        assertTrue(policy.qualifiesByOwnership(fi, direct("0", null, null, null, "2", false)));
+        assertFalse(policy.qualifiesByOwnership(plc, direct("0", null, null, null, "50", false)));
+    }
+
+    @Test
