+        var mining = policy.resolve(EntityType.SHARE_COMPANY, Sector.MINING);
+        var plc = policy.resolve(EntityType.PRIVATE_LIMITED_COMPANY, null);
+        var fi = policy.resolve(EntityType.FINANCIAL_INSTITUTION, null);
