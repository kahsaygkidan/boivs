+class BoThresholdPolicyTest {
+
+    private final BoThresholdPolicy policy = new BoThresholdPolicy(new BigDecimal("25"));
+
+    private static BigDecimal d(String v) {
+        return new BigDecimal(v);
+    }
+
+    private static Stake direct(String own, String profit, String dissolution, String voting, String debt,
+                                boolean preferential) {
+        return Stake.root().through(d(own), profit == null ? null : d(profit), dissolution == null ? null : d(dissolution),
+                voting == null ? null : d(voting), debt == null ? null : d(debt), preferential);
+    }
+
+    @Test
+    void thresholdsPerEntityTypeAndSector() {
+        assertEquals(0, d("10").compareTo(policy.resolve(EntityType.SHARE_COMPANY, Sector.OTHER).threshold()));
+        assertEquals(0, d("10").compareTo(policy.resolve(EntityType.SHARE_COMPANY, null).threshold()));
+        for (Sector s : new Sector[] {Sector.MINING, Sector.REAL_ESTATE, Sector.MOTOR_DEALERSHIP, Sector.IMPORT_EXPORT}) {
+            assertEquals(0, d("5").compareTo(policy.resolve(EntityType.SHARE_COMPANY, s).threshold()), s.name());
+        }
+        assertEquals(0, d("5").compareTo(policy.resolve(EntityType.PRIVATE_LIMITED_COMPANY, null).threshold()));
+        assertEquals(0, d("2").compareTo(policy.resolve(EntityType.FINANCIAL_INSTITUTION, null).threshold()));
+        for (EntityType t : new EntityType[] {EntityType.GENERAL_PARTNERSHIP, EntityType.LIMITED_PARTNERSHIP,
+                EntityType.LIMITED_LIABILITY_PARTNERSHIP, EntityType.PPP}) {
+            assertEquals(0, d("25").compareTo(policy.resolve(t, null).threshold()), t.name());
+        }
+    }
+
+    @Test
+    void uncoveredTypesAndForeignUseFallback() {
+        for (EntityType t : new EntityType[] {EntityType.FOREIGN_LEGAL_PERSON, EntityType.PUBLIC_LIMITED_COMPANY,
+                EntityType.TRUST}) {
+            assertEquals(Mode.FALLBACK, policy.resolve(t, null).mode(), t.name());
+            assertEquals(0, d("25").compareTo(policy.resolve(t, null).threshold()), t.name());
+        }
+    }
+
+    @Test
+    void inclusiveThresholdAndRoundingTolerance() {
+        var rule = policy.resolve(EntityType.SHARE_COMPANY, Sector.OTHER);
+        assertTrue(policy.qualifiesByOwnership(rule, d("10")));
+        assertTrue(policy.qualifiesByOwnership(rule, d("9.99999999")));
+        assertFalse(policy.qualifiesByOwnership(rule, d("9.9")));
+    }
+
+    @Test
+    void indirectHoldingIsMultipliedThroughTheChainAndAddedToDirect() {
+        var rule = policy.resolve(EntityType.SHARE_COMPANY, Sector.OTHER);
+        Stake holdco = Stake.root().through(d("20"), null, null, null, null, false);
+        Stake indirect = holdco.through(d("50"), null, null, null, null, false); // 50% of a 20% holder = 10%
+        assertEquals(0, d("10").compareTo(indirect.ownership()));
+        assertTrue(policy.qualifiesByOwnership(rule, indirect));
+        assertTrue(policy.qualifiesByOwnership(rule, direct("4", null, null, null, null, false).plus(indirect)));
+        assertFalse(policy.qualifiesByOwnership(rule, direct("4", null, null, null, null, false)));
+    }
+
+    @Test
